# ---------------------------------------------------------------
# FinanceRAG configuration.
# Copy to .env and adjust. Never commit real secrets.
#
# Hostnames below assume Docker Compose (service names). When
# running the API directly on the host, replace them with
# "localhost".
# ---------------------------------------------------------------

# --- Application ---
APP_NAME=VANGAURD.AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://financerag:financerag@postgres:5432/financerag

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=financerag_documents
# QDRANT_API_KEY=

# --- Document storage ---
# Inside Docker a named volume is mounted at /data/documents.
# For host-based development use a writable local path, e.g. ./data/documents
STORAGE_PATH=/data/documents
# STORAGE_BACKEND=local

# --- Authentication ---
# Generate a real secret for anything beyond local development:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (OpenAI-compatible: vLLM, Ollama, external APIs) ---
# Optional: the API runs and reports health without any LLM configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Reranking (Phase 5) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_TOP_K=15

# --- Embeddings (reserved for Phase 3) ---
EMBEDDING_MODEL=

# --- First-run seeding (scripts/seed.py) ---
# SEED_ADMIN_EMAIL=admin@financerag.local
# SEED_ADMIN_PASSWORD=

# --- Docker Hub deployment (used only by docker-compose.hub.yml, Phase 2+) ---
# DOCKERHUB_USERNAME=your-docker-hub-username
# FINANCERAG_VERSION=v0.1.0